# IA (obligatorio para el motor nuevo — cv_profile.py y semantic_match.py)
# Sacala gratis en https://console.groq.com
GROQ_API_KEY=gsk_...

# Supabase (Fase 2 — persistencia). Si se dejan vacías, la API usa
# automáticamente el storage temporal en archivos JSON (data/db/).
# Sacá estos valores en tu proyecto de Supabase -> Project Settings -> API Keys.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Jooble (fuente general de empleo, sources/jooble.py). Key gratuita en
# jooble.org/api/about. OJO: el plan gratuito tiene 500 requests EN TOTAL
# (de por vida). Si se deja vacía, la fuente se saltea sin romper nada.
JOOBLE_API_KEY=...

# Cohere — filtro semantico (etapa 1 del matching). Reemplaza al modelo
# local, que hacia que el motor no entrara en los 512 MB de un plan gratis.
# Trial key gratuita en dashboard.cohere.com
COHERE_API_KEY=...

# Avisos semanales por mail (notificaciones_semanales.py). Key gratuita
# en resend.com. Dominio propio verificado desde el 20/08/2026
# (empatianextstep.com, en Cloudflare) — el remitente por defecto ya lo usa.
RESEND_API_KEY=re_...
# Opcionales — tienen un valor por defecto razonable si se dejan vacíos:
# RESEND_FROM_EMAIL=EmpatÍA | NextStep <avisos@empatianextstep.com>
# SITE_URL=https://jobscraping.vercel.app

# Telegram (opcional — solo si seguís usando el bot viejo, bot_listener.py)
TELEGRAM_BOT_TOKEN=123456789:AABBCCDDaabbccdd...
TELEGRAM_CHAT_ID=123456789

# --- Opcional: LLM de la etapa 2 (semantic_match.py) en otro proveedor ---
# Mismo modelo open-source (gpt-oss-120b) servido por un proveedor compatible
# con la API de OpenAI. Si LLM_BASE_URL está vacío, se usa Groq.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=openai/gpt-oss-120b
# Sólo OpenRouter: fijar un proveedor para que los scores sean estables
# LLM_PROVIDER=deepinfra
# Cuántas finalistas lee el LLM y cuántas llamadas en paralelo hace:
# EXPLAIN_TOP_N=30
# LLM_MAX_PARALLEL=6

# Careerjet (sources/careerjet.py): key gratis creando cuenta de partner en careerjet.com
# CAREERJET_API_KEY=
